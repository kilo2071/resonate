<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="ResonateSettingsPage" parent="AdwPreferencesPage">
    <property name="title" translatable="yes">Settings</property>

    <!-- Sounds Library -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Sounds Library</property>
        <property name="description" translatable="yes">Where your sound files are stored</property>
        <child>
          <object class="AdwActionRow" id="sounds_folder_row">
            <property name="title" translatable="yes">Sounds Folder</property>
            <property name="subtitle" translatable="yes">~/Documents/Sounds</property>
            <property name="activatable">true</property>
            <child type="suffix">
              <object class="GtkImage">
                <property name="icon-name">folder-symbolic</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="move_files_row">
            <property name="title" translatable="yes">Move Added Files</property>
            <property name="subtitle" translatable="yes">Move new sounds into the Sounds Folder when added</property>
            <property name="active">false</property>
          </object>
        </child>
      </object>
    </child>

    <!-- Audio Input -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Audio Input</property>
        <property name="description" translatable="yes">Microphone source for the effects chain</property>
        <child>
          <object class="AdwComboRow" id="input_device_row">
            <property name="title" translatable="yes">Input Device</property>
          </object>
        </child>
      </object>
    </child>

    <!-- Monitor Output -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Monitor Output</property>
        <property name="description" translatable="yes">Hear soundboard playback yourself on the system default output</property>
        <child>
          <object class="AdwSwitchRow" id="monitor_enabled_row">
            <property name="title" translatable="yes">Enable Monitor</property>
            <property name="subtitle" translatable="yes">Play soundboard audio on your speakers/headphones</property>
            <property name="active">true</property>
          </object>
        </child>
      </object>
    </child>

    <!-- Playback -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Playback</property>
        <child>
          <object class="AdwSwitchRow" id="polyphonic_row">
            <property name="title" translatable="yes">Play Multiple Sounds</property>
            <property name="subtitle" translatable="yes">Allow more than one sound to play at the same time</property>
            <property name="active">true</property>
          </object>
        </child>
        <child>
          <object class="AdwSpinRow" id="default_volume_row">
            <property name="title" translatable="yes">Default Volume</property>
            <property name="subtitle" translatable="yes">Starting volume for newly added sounds (0–100)</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">0</property>
                <property name="upper">100</property>
                <property name="value">100</property>
                <property name="step-increment">1</property>
                <property name="page-increment">10</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>

    <!-- Virtual Device -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Virtual Device</property>
        <property name="description" translatable="yes">The PipeWire virtual microphone other apps see</property>
        <child>
          <object class="AdwEntryRow" id="virtual_device_name_row">
            <property name="title" translatable="yes">Device Name</property>
            <property name="text">Resonate Microphone</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="autostart_virtual_device_row">
            <property name="title" translatable="yes">Start on Launch</property>
            <property name="subtitle" translatable="yes">Create the virtual device automatically when Resonate opens</property>
            <property name="active">true</property>
          </object>
        </child>
      </object>
    </child>

    <!-- Startup -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Startup</property>
        <property name="description" translatable="yes">Run Resonate in the background to keep mic effects active</property>
        <child>
          <object class="AdwSwitchRow" id="start_on_login_row">
            <property name="title" translatable="yes">Start on Login</property>
            <property name="subtitle" translatable="yes">Launch hidden at login and keep the mic effects running in the background (closing the window hides it to the tray)</property>
            <property name="active">false</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
